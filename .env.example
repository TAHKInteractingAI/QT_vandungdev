APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development

# Shared secret key between Cron Scheduler / Cloudflare Worker and FastAPI
CRON_API_KEY=test-secret-key-123

# Default crawler settings
DEFAULT_KEYWORD="Trillion"
DEFAULT_MAX_ARTICLES=20
DEFAULT_WORKERS=5
DEFAULT_LANG=vi
DEFAULT_COUNTRY=VN
DEFAULT_TIMEOUT=10
DEFAULT_ROTATE_UA=false
DEFAULT_RESUME=true
DEFAULT_SHOW_PROGRESS=false

STORAGE_DIR=storage/outputs
JOBS_METADATA_DIR=storage/jobs
